classDiagram
    %% PawPal+ final class design. Matches pawpal_system.py.
    %% Helpers to_minutes("HH:MM") -> int and to_hhmm(int) -> str are module-level functions.

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet_name: str) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +str special_needs
        +list~Task~ tasks
        +add_task(task: Task) None
        +edit_task(title: str, **changes) None
        +remove_task(title: str) None
        +get_pending_tasks() list~Task~
        -_find_task(title: str) Task
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str|None preferred_time
        +str frequency
        +bool completed
        +date due_date
        +str pet_name
        +priority_value() int
        +is_due(day: date) bool
        +mark_complete(today: date|None) Task|None
    }

    class Scheduler {
        +Owner owner
        +str day_start
        +generate_plan(day: date) Schedule
        +sort_tasks(tasks: list~Task~) list~Task~
        +sort_by_time(tasks: list~Task~) list~Task~
        +filter_tasks(tasks: list~Task~, day: date) list~Task~
        +filter_by(pet_name: str|None, completed: bool|None) list~Task~
        +mark_task_complete(pet_name: str, title: str, today: date|None) Task|None
        +find_conflicts(items: list~ScheduledItem~) list~tuple~
        +detect_conflicts(items: list~ScheduledItem~) list~str~
        +apply_preferences(tasks: list~Task~) list~Task~
        -_valid_time(hhmm: str) bool$
        -_next_free_slot(start: int, duration: int, busy: list) int
        -_make_item(task: Task, start: int, reason: str) ScheduledItem
    }

    class Schedule {
        +date day
        +list~ScheduledItem~ items
        +list~Task~ skipped
        +dict skip_reasons
        +list~str~ warnings
        +total_minutes() int
        +explain() str
    }

    class ScheduledItem {
        +Task task
        +str start_time
        +str end_time
        +str reason
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" *-- "*" Task : has
    Task ..> Task : mark_complete() creates next occurrence
    Scheduler --> Owner : reads constraints and tasks from
    Scheduler ..> Pet : adds next occurrence to
    Scheduler ..> Schedule : creates
    Scheduler ..> ScheduledItem : creates
    Schedule "1" *-- "*" ScheduledItem : contains
    Schedule "1" o-- "*" Task : skipped
    ScheduledItem --> Task : wraps
